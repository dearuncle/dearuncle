from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.options import Options
import time
import os

# 🔧 설정값
GRAFANA_URL = "http://localhost:3000/d/abcd1234/my-dashboard"
GRAFANA_USER = "your_username"
GRAFANA_PASS = "your_password"
CSV_DOWNLOAD_DIR = "D:/temp2/grafana_csv"
TARGET_PANEL_TITLE = "한전FTP전송내역"

# 📁 다운로드 폴더 생성
if not os.path.exists(CSV_DOWNLOAD_DIR):
    os.makedirs(CSV_DOWNLOAD_DIR)

# 🧙 크롬 옵션 설정
chrome_options = Options()
chrome_options.add_argument("--headless")
chrome_options.add_experimental_option("prefs", {
    "download.default_directory": CSV_DOWNLOAD_DIR,
    "download.prompt_for_download": False,
    "download.directory_upgrade": True,
    "safebrowsing.enabled": True
})

driver = webdriver.Chrome(options=chrome_options)

try:
    # 1️⃣ 로그인
    driver.get(GRAFANA_URL)
    time.sleep(2)
    driver.find_element(By.NAME, "user").send_keys(GRAFANA_USER)
    driver.find_element(By.NAME, "password").send_keys(GRAFANA_PASS)
    driver.find_element(By.CSS_SELECTOR, "button[type='submit']").click()
    time.sleep(3)

    # 2️⃣ 대시보드 재진입
    driver.get(GRAFANA_URL)
    time.sleep(5)

    # 3️⃣ 정확한 data-testid로 section 찾기
    selector = f'section[data-testid*="Panel header {TARGET_PANEL_TITLE}"]'
    section = driver.find_element(By.CSS_SELECTOR, selector)
    print("✅ 대상 패널 section 찾음!")

    # 4️⃣ 해당 section 내부에서 메뉴 버튼 클릭
    menu_button = section.find_element(By.CSS_SELECTOR, f'button[data-testid*="Panel menu {TARGET_PANEL_TITLE}"]')
    menu_button.click()
    time.sleep(1)

    # 5️⃣ 'Download CSV' 메뉴 클릭
    csv_button = driver.find_element(By.XPATH, "//span[text()='Download CSV']")
    csv_button.click()
    print("📥 CSV 다운로드 클릭 완료!")

    time.sleep(5)
    print("📂 다운로드 완료:", os.listdir(CSV_DOWNLOAD_DIR))

except Exception as e:
    print("❌ 오류 발생:", e)

finally:
    driver.quit()

✅ Step 1. 다운로드된 최신 CSV 찾고 → 원하는 이름으로 변경
import glob
import time
import os

def rename_latest_csv(download_dir, new_filename):
    # 다운로드 디렉토리에서 가장 최근 .csv 파일 찾기
    list_of_files = glob.glob(os.path.join(download_dir, "*.csv"))
    if not list_of_files:
        print("❌ CSV 파일 없음!")
        return None

    latest_file = max(list_of_files, key=os.path.getctime)
    new_path = os.path.join(download_dir, new_filename)

    os.rename(latest_file, new_path)
    print(f"✅ 파일명 변경 완료: {os.path.basename(latest_file)} → {new_filename}")
    return new_path


✅ Step 2. Pandas로 읽고 엑셀 저장 (엑셀 스타일까지 적용 가능)

import pandas as pd

def save_csv_to_excel(csv_path, excel_path):
    df = pd.read_csv(csv_path)
    print("📄 CSV 로드 완료:\n", df.head())

    # Excel 저장
    df.to_excel(excel_path, index=False, engine="openpyxl")
    print(f"📊 엑셀 저장 완료: {excel_path}")

