def get_unique_filename(base_dirname, base_filename):
    filename, fileext = os.path.splitext(base_filename)
    candidate = os.path.join(base_dirname, base_filename)
    counter = 1
    while os.path.exists(candidate):
        candidate = os.path.join(base_dirname, f"{filename}_{counter}{fileext}")
        counter += 1
    return candidate
    
    
def rename_latest_csv(download_dir, base_filename):
    # 다운로드 디렉토리에서 가장 최근 .csv 파일 찾기
    list_of_files = glob.glob(os.path.join(download_dir, "*.csv"))
    if not list_of_files:
        print("❌ CSV 파일 없음!")
        return None

    latest_file = max(list_of_files, key=os.path.getctime)
    #new_path = os.path.join(download_dir, base_filename)
    new_path = get_unique_filename(download_dir, base_filename)
    os.rename(latest_file, new_path)
    log(f"다운로드한 파일명 : {os.path.basename(latest_file)}")
    log(f"변경한     파일명 : {new_path}")
    return new_path

