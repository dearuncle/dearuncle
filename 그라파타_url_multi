def download_grafana_panels(GRAFANA_URL, GRAFANA_USER, GRAFANA_PASS, TARGET_PANEL_TITLES, CSV_DOWNLOAD_DIR, log):
    # 🧙 크롬 옵션 설정
    chrome_options = Options()
    #chrome_options.add_argument("--headless")
    chrome_options.add_experimental_option("prefs", {
        "download.default_directory": os.path.abspath(CSV_DOWNLOAD_DIR),
        "download.prompt_for_download": False,
        "download.directory_upgrade": True,
        "safebrowsing.enabled": True
    })

    driver = webdriver.Chrome(options=chrome_options)

    try:
        # 1️⃣ 로그인
        log("URL 접속중 ... ")
        driver.get(GRAFANA_URL)
        time.sleep(2)

        log("로그인중 ... ")
        driver.find_element(By.NAME, "user").send_keys(GRAFANA_USER)
        driver.find_element(By.NAME, "password").send_keys(GRAFANA_PASS)
        driver.find_element(By.CSS_SELECTOR, "button[type='submit']").click()
        time.sleep(3)

        # 2️⃣ 대시보드 재진입
        log("대시보드 진입 및 대기중 ... ")
        driver.get(GRAFANA_URL)
        time.sleep(5)

        for TARGET_PANEL in TARGET_PANEL_TITLES:
            try:
                panel_found = False
                #last_height = driver.execute_script("return document.body.scrollHeight")
                last_height = driver.execute_script("""
    let container = document.querySelector('.scrollbar-view');
    if (container) {
        return container.scrollHeight;
    } else {
        return document.body.scrollHeight;
    }
""")

                while True:
                    try:
                        # 3️⃣ 정확한 data-testid로 section 찾기
                        log("대상 패널 찾는중 ... ")
                        selector = f'section[data-testid*="Panel header {TARGET_PANEL}"]'
                        section = driver.find_element(By.CSS_SELECTOR, selector)
                        log("대상 패널 찾음 : " + TARGET_PANEL)
                        driver.execute_script("arguments[0].scrollIntoView({block: 'center'});", section)
                        time.sleep(0.5)
                        # 4️⃣ 해당 section 내부에서 메뉴 버튼 클릭
                        menu_button = section.find_element(By.CSS_SELECTOR, f'button[data-testid*="Panel menu {TARGET_PANEL}"]')
                        driver.execute_script("arguments[0].click();", menu_button)
                        time.sleep(1)
                        inspect_button = driver.find_element(By.XPATH, "//span[text()='Inspect']")
                        driver.execute_script("arguments[0].click();", inspect_button)
                        time.sleep(1)
                        # 5️⃣ 'Download CSV' 메뉴 클릭
                        csv_button = driver.find_element(By.XPATH, "//span[text()='Download CSV']")
                        driver.execute_script("arguments[0].click();", csv_button)
                        log(f"패널[{TARGET_PANEL}] CSV 다운로드 완료")
                        time.sleep(5)
                        # 다운로드 후 파일명 변경
                        csv_file_path = TARGET_PANEL+'_'+in_base_date+'.csv'
                        renamed_csv_file_path = rename_latest_csv(CSV_DOWNLOAD_DIR, csv_file_path)
                        # Pandas로 읽고 엑셀 저장
                        if renamed_csv_file_path:
                            save_csv_to_excel(renamed_csv_file_path)
                        panel_found = True
                        break
                    except:
                        #못찾았을경우 , 화면을 아래로 스크롤해서 다시 찾는다.
                        log("대상 패널 못찾음 : 화면을 스크롤해서 다시 검색중..")
                        driver.execute_script("""
    let container = document.querySelector('.scrollbar-view');
    if (container) {
        container.scrollTop += 400;
        return container.scrollTop;
    } else {
        window.scrollBy(0, 400);
        return window.pageYOffset;
    }
""")
                        time.sleep(0.5)
                        new_height = driver.execute_script("""
    let container = document.querySelector('.scrollbar-view');
    if (container) {
        return container.scrollTop + container.clientHeight;
    } else {
        return window.pageYOffset + window.innerHeight;
    }
""")
                        #driver.execute_script("window.scrollBy(0, 400);")
                        #time.sleep(0.5)
                        #new_height = driver.execute_script("return window.pageYOffset + window.innerHeight")
                        if new_height >= last_height:
                            break
                if not panel_found:
                    log(f"❌ [{TARGET_PANEL}] 패널을 찾을 수 없습니다.")
            except Exception as e:
                #log(f"[{TARGET_PANEL}] 패널 오류 발생:"+ e)
                print(f"❌ [{TARGET_PANEL}] 패널 오류 발생:", e)
    except Exception as e:
        #log("오류 발생:"+ e)
        print("❌ 오류 발생:", e)

    finally:
        print("끝~")
        #driver.quit()
        

