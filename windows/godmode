✅ SYSTEM CMD 자동 실행 배치 스크립트 (RunAsSystemCMD.bat)
@echo off
set taskName=TempSystemCMDTask

:: 1. 작업 스케줄러에 SYSTEM 권한 작업 생성
schtasks /create /tn "%taskName%" /tr "cmd.exe" /sc ONCE /st 00:00 /ru "SYSTEM" /f

:: 2. 생성한 작업을 즉시 실행
schtasks /run /tn "%taskName%"

:: 3. 3초 대기 후 작업 삭제 (작업은 이미 실행되므로 삭제해도 영향 없음)
timeout /t 3 > nul
schtasks /delete /tn "%taskName%" /f

exit


@echo off
set taskName=TempSystemCMDTask

:: 현재 시간 기준 +1분 계산 (HH:MM 형식)
for /f "tokens=1-2 delims=:" %%a in ("%time%") do (
    set /a hh=1%%a %% 100
    set /a mm=1%%b + 1
)

:: 분이 60이 넘는 경우 조정
if %mm% GEQ 60 (
    set /a mm=mm - 60
    set /a hh=hh + 1
)

:: 시, 분을 두 자리 수로 포맷
if %hh% LSS 10 set hh=0%hh%
if %mm% LSS 10 set mm=0%mm%

set startTime=%hh%:%mm%

:: 1. 작업 생성
schtasks /create /tn "%taskName%" /tr "cmd.exe" /sc ONCE /st %startTime% /ru "SYSTEM" /f

:: 2. 실행 (혹시 몰라 약간 대기)
timeout /t 5 > nul
schtasks /run /tn "%taskName%"

:: 3. 실행 후 잠깐 기다렸다가 삭제
timeout /t 5 > nul
schtasks /delete /tn "%taskName%" /f

exit



✅ 사용 방법
메모장에 위 내용을 복사하여 붙여넣기

RunAsSystemCMD.bat 이름으로 저장

우클릭 → 관리자 권한으로 실행

실행 결과:
SYSTEM 계정 권한으로 CMD 창이 뜹니다.

whoami 입력 시 nt authority\system 확인 가능

💡 참고
schtasks는 Windows에 기본 내장된 명령어입니다.

schtasks /sc ONCE /st 00:00은 "지금 바로 실행하기 위한 가짜 스케줄"이며, 실행 후 바로 삭제하므로 시스템에 남지 않습니다.
