import tkinter as tk
from tkinter import messagebox
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.options import Options
import time
import os


def collect_grafana_inputs():
    def on_submit():
        url = url_entry.get().strip()
        user = user_entry.get().strip()
        password = password_entry.get().strip()
        panels_raw = panels_text.get("1.0", tk.END).strip()
        panel_list = [p.strip() for p in panels_raw.split(",") if p.strip()]

        if not url or not user or not password or not panel_list:
            messagebox.showerror("입력 오류", "모든 필드를 채워주세요.")
            return

        # 저장 후 종료
        inputs["url"] = url
        inputs["user"] = user
        inputs["password"] = password
        inputs["panels"] = panel_list
        root.destroy()

    inputs = {}
    root = tk.Tk()
    root.title("Grafana 패널 다운로드 설정")

    tk.Label(root, text="Grafana 대시보드 URL").grid(row=0, column=0, sticky="w")
    url_entry = tk.Entry(root, width=60)
    url_entry.grid(row=0, column=1)

    tk.Label(root, text="사용자 ID").grid(row=1, column=0, sticky="w")
    user_entry = tk.Entry(root, width=30)
    user_entry.grid(row=1, column=1, sticky="w")

    tk.Label(root, text="비밀번호").grid(row=2, column=0, sticky="w")
    password_entry = tk.Entry(root, width=30, show="*")
    password_entry.grid(row=2, column=1, sticky="w")

    tk.Label(root, text="패널 제목 목록 (쉼표로 구분)").grid(row=3, column=0, sticky="nw")
    panels_text = tk.Text(root, width=60, height=4)
    panels_text.grid(row=3, column=1, pady=5)

    submit_btn = tk.Button(root, text="확인", command=on_submit)
    submit_btn.grid(row=4, column=1, pady=10, sticky="e")

    root.mainloop()
    return inputs if inputs else None


def download_grafana_panels(url, user, password, panel_titles, download_dir):
    chrome_options = Options()
    chrome_options.add_experimental_option("prefs", {
        "download.default_directory": os.path.abspath(download_dir),
        "download.prompt_for_download": False,
        "safebrowsing.enabled": True
    })
    # chrome_options.add_argument("--headless")  # 테스트 시 주석 처리
    driver = webdriver.Chrome(options=chrome_options)

    try:
        driver.get(url)
        time.sleep(2)
        driver.find_element(By.NAME, "user").send_keys(user)
        driver.find_element(By.NAME, "password").send_keys(password)
        driver.find_element(By.CSS_SELECTOR, "button[type='submit']").click()
        time.sleep(3)

        driver.get(url)
        time.sleep(5)

        for panel_title in panel_titles:
            try:
                print(f"\n🔍 패널 찾는 중: {panel_title}")
                selector = f'section[data-testid*="Panel header {panel_title}"]'
                section = driver.find_element(By.CSS_SELECTOR, selector)
                menu_button = section.find_element(By.CSS_SELECTOR, f'button[data-testid*="Panel menu {panel_title}"]')
                driver.execute_script("arguments[0].click();", menu_button)
                time.sleep(1)

                inspect_btn = driver.find_element(By.XPATH, "//span[text()='Inspect']")
                driver.execute_script("arguments[0].click();", inspect_btn)
                time.sleep(1)

                csv_btn = driver.find_element(By.XPATH, "//span[text()='Download CSV']")
                driver.execute_script("arguments[0].click();", csv_btn)
                print(f"📥 [{panel_title}] CSV 다운로드 완료")
                time.sleep(3)

            except Exception as e:
                print(f"❌ [{panel_title}] 패널 오류:", e)

        print("\n✅ 모든 패널 다운로드 완료")

    except Exception as e:
        print("❌ 전체 오류:", e)

    finally:
        driver.quit()


# 메인 실행
user_inputs = collect_grafana_inputs()
if user_inputs:
    download_dir = "D:/temp2/grafana_csv"
    if not os.path.exists(download_dir):
        os.makedirs(download_dir)

    download_grafana_panels(
        url=user_inputs["url"],
        user=user_inputs["user"],
        password=user_inputs["password"],
        panel_titles=user_inputs["panels"],
        download_dir=download_dir
    )
else:
    print("❌ 입력 취소 또는 오류")






import tkinter as tk
from tkinter import messagebox, filedialog
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.chrome.options import Options
import time
import os
import json
from datetime import datetime

# 외부 JSON에서 리포트 정보 불러오기
with open("reports.json", "r", encoding="utf-8") as f:
    REPORTS = json.load(f)

def collect_grafana_inputs(log_callback):
    def on_report_select(*args):
        selected = report_var.get()
        url_entry.delete(0, tk.END)
        url_entry.insert(0, REPORTS[selected]["url"])
        panel_menu['menu'].delete(0, 'end')
        new_panels = REPORTS[selected]["panels"]
        panel_var.set(new_panels[0])
        for panel in new_panels:
            panel_menu['menu'].add_command(label=panel, command=tk._setit(panel_var, panel))

    def on_submit():
        url = url_entry.get().strip()
        user = user_entry.get().strip()
        password = password_entry.get().strip()
        date_filter = date_entry.get().strip()
        selected_panel = panel_var.get().strip()
        folder = download_path.get().strip()

        if not url or not user or not password or not selected_panel or not folder:
            messagebox.showerror("입력 오류", "모든 필드를 채워주세요.")
            return

        inputs["url"] = url
        inputs["user"] = user
        inputs["password"] = password
        inputs["panels"] = [selected_panel]
        inputs["date"] = date_filter
        inputs["folder"] = folder

    def browse_folder():
        folder_selected = filedialog.askdirectory()
        if folder_selected:
            download_path.set(folder_selected)

    inputs = {}
    root = tk.Toplevel()
    root.title("Grafana 패널 다운로드 설정")
    root.resizable(False, False)
    root.configure(bg="#f4f4f8")

    font_style = ("맑은 고딕", 10)
    label_fg = "#333"

    tk.Label(root, text="리포트 선택", bg="#f4f4f8", fg=label_fg, font=font_style).grid(row=0, column=0, sticky="w")
    report_var = tk.StringVar(value=list(REPORTS.keys())[0])
    report_menu = tk.OptionMenu(root, report_var, *REPORTS.keys(), command=on_report_select)
    report_menu.config(font=font_style)
    report_menu.grid(row=0, column=1, columnspan=2, sticky="w")

    tk.Label(root, text="Grafana 대시보드 URL", bg="#f4f4f8", fg=label_fg, font=font_style).grid(row=1, column=0, sticky="w")
    url_entry = tk.Entry(root, width=60, font=font_style)
    url_entry.grid(row=1, column=1, columnspan=2, sticky="w")
    url_entry.insert(0, REPORTS[report_var.get()]["url"])

    tk.Label(root, text="사용자 ID", bg="#f4f4f8", fg=label_fg, font=font_style).grid(row=2, column=0, sticky="w")
    user_entry = tk.Entry(root, width=30, font=font_style)
    user_entry.insert(0, "admin")
    user_entry.grid(row=2, column=1, columnspan=2, sticky="w")

    tk.Label(root, text="비밀번호", bg="#f4f4f8", fg=label_fg, font=font_style).grid(row=3, column=0, sticky="w")
    password_entry = tk.Entry(root, width=30, show="*", font=font_style)
    password_entry.grid(row=3, column=1, columnspan=2, sticky="w")

    tk.Label(root, text="조회 기준 날짜 (YYYYMMDD)", bg="#f4f4f8", fg=label_fg, font=font_style).grid(row=4, column=0, sticky="w")
    date_entry = tk.Entry(root, width=20, font=font_style)
    date_entry.insert(0, datetime.today().strftime('%Y%m%d'))
    date_entry.grid(row=4, column=1, columnspan=2, sticky="w")

    tk.Label(root, text="다운로드 저장 경로", bg="#f4f4f8", fg=label_fg, font=font_style).grid(row=5, column=0, sticky="w")
    download_path = tk.StringVar()
    path_frame = tk.Frame(root, bg="#f4f4f8")
    path_frame.grid(row=5, column=1, columnspan=2, sticky="w")
    path_entry = tk.Entry(path_frame, textvariable=download_path, width=40, font=font_style)
    path_entry.pack(side="left")
    browse_btn = tk.Button(path_frame, text="찾아보기", command=browse_folder, font=font_style, bg="#ffffff")
    browse_btn.pack(side="left", padx=5)

    tk.Label(root, text="패널 선택", bg="#f4f4f8", fg=label_fg, font=font_style).grid(row=6, column=0, sticky="w")
    panel_var = tk.StringVar(value=REPORTS[report_var.get()]["panels"][0])
    panel_menu = tk.OptionMenu(root, panel_var, *REPORTS[report_var.get()]["panels"])
    panel_menu.config(font=font_style)
    panel_menu.grid(row=6, column=1, columnspan=2, sticky="w")

    submit_btn = tk.Button(root, text="확인", command=on_submit, font=("맑은 고딕", 10, "bold"), bg="#4CAF50", fg="white")
    submit_btn.grid(row=7, column=1, pady=10, sticky="e")

    cancel_btn = tk.Button(root, text="취소", command=root.quit, font=("맑은 고딕", 10, "bold"), bg="#f44336", fg="white")
    cancel_btn.grid(row=7, column=0, pady=10, sticky="w")

    log_text = tk.Text(root, height=10, width=80, font=("맑은 고딕", 9), bg="#f9f9f9")
    log_text.grid(row=8, column=0, columnspan=3, padx=10, pady=10)

    def log(message):
        log_text.insert(tk.END, message + "\n")
        log_text.see(tk.END)

    root.protocol("WM_DELETE_WINDOW", root.quit)
    root.grab_set()
    root.mainloop()
    return inputs if inputs else None, log

def download_grafana_panels(url, user, password, panel_titles, download_dir, log):
    chrome_options = Options()
    chrome_options.add_experimental_option("prefs", {
        "download.default_directory": os.path.abspath(download_dir),
        "download.prompt_for_download": False,
        "safebrowsing.enabled": True
    })
    driver = webdriver.Chrome(options=chrome_options)

    try:
        driver.get(url)
        time.sleep(2)
        driver.find_element(By.NAME, "user").send_keys(user)
        driver.find_element(By.NAME, "password").send_keys(password)
        driver.find_element(By.CSS_SELECTOR, "button[type='submit']").click()
        time.sleep(3)

        driver.get(url)
        time.sleep(5)

        for panel_title in panel_titles:
            try:
                log(f"🔍 패널 찾는 중: {panel_title}")
                selector = f'section[data-testid*="Panel header {panel_title}"]'
                section = driver.find_element(By.CSS_SELECTOR, selector)
                menu_button = section.find_element(By.CSS_SELECTOR, f'button[data-testid*="Panel menu {panel_title}"]')
                driver.execute_script("arguments[0].click();", menu_button)
                time.sleep(1)

                inspect_btn = driver.find_element(By.XPATH, "//span[text()='Inspect']")
                driver.execute_script("arguments[0].click();", inspect_btn)
                time.sleep(1)

                csv_btn = driver.find_element(By.XPATH, "//span[text()='Download CSV']")
                driver.execute_script("arguments[0].click();", csv_btn)
                log(f"📥 [{panel_title}] CSV 다운로드 완료")
                time.sleep(3)

            except Exception as e:
                log(f"❌ [{panel_title}] 패널 오류: {e}")

        log("✅ 모든 패널 다운로드 완료")
        messagebox.showinfo("완료", "CSV 다운로드가 완료되었습니다.")

    except Exception as e:
        log(f"❌ 전체 오류: {e}")

    finally:
        driver.quit()

# GUI → 다운로드 → 다시 GUI 반복
while True:
    result = collect_grafana_inputs(log_callback=None)
    if not result:
        break
    user_inputs, log = result
    if not user_inputs:
        break

    download_grafana_panels(
        url=user_inputs["url"],
        user=user_inputs["user"],
        password=user_inputs["password"],
        panel_titles=user_inputs["panels"],
        download_dir=user_inputs["folder"],
        log=log
    )
