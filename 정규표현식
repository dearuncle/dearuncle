    # 패턴 1: 파일명 뒤에 날짜가 있는 경우 → name_YYYYMMDD.ext
    s|^([0-9]+)\|(.*/)?(.+)_([0-9]{6,12})\.([^.]+)$|\1 \3 \4 \5|p
    t done
    # 패턴 2: 날짜가 앞에 있는 경우 → YYYYMMDD_name.ext
    s|^([0-9]+)\|(.*/)?([0-9]{6,12})_(.+)\.([^.]+)$|\1 \4 \3 \5|p
    :done
'
🔍 변경 요점
항목	변경 내용
(.*/)?	경로를 선택적으로 허용 (basename만 추출)
(.+)_([0-9]{6,12})	base와 날짜 구분을 모든 문자 허용으로 완화
t done	첫 번째 패턴이 성공하면 두 번째는 건너뜀
--
sed -En '
  # 패턴 1: name_YYYYMMDD.ext
  s|^([0-9]+)\|.*/(.+)_([0-9]{6,12})\.([^.]+)$|\1 \2 \3 \4|p
  t done
  # 패턴 2: YYYYMMDD_name.ext
  s|^([0-9]+)\|.*/([0-9]{6,12})_(.+)\.([^.]+)$|\1 \3 \2 \4|p
  :done
'
